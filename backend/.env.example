# Backend environment variables
# Copy this file to .env and adjust values before running.

# ─── Application ──────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database ─────────────────────────────────────────────
# Path to SQLite database file
DATABASE_PATH=vulnwatch.db

# ─── Security ─────────────────────────────────────────────
SECRET_KEY=replace-with-a-secure-random-secret-key

# ─── Scanner Scope ────────────────────────────────────────
# Comma-separated list of authorized scan targets (restricted to local loopback)
ALLOWED_TARGETS=localhost,127.0.0.1,::1
