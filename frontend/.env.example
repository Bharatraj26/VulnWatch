# Frontend environment variables
# Copy this file to .env.local before running `npm run dev`.

# Base URL of the VulnWatch Flask API.
# During development, Vite's proxy forwards /api/* requests to http://localhost:8000
# If connecting directly without Vite proxy, set VITE_API_URL:
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
